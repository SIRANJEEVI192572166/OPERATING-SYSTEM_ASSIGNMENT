[Unit]
Description=University Result Portal (gunicorn)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal
ExecStart=/usr/local/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
